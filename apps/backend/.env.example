# Copy this file to `.env` before starting the stack. Never commit `.env`.
#   cp apps/backend/.env.example apps/backend/.env

# API
PORT=3000

# PostgreSQL (matches docker-compose.yml by default)
#
# Local development (backend on the host): localhost + the Docker host port.
# Docker (api / db-setup containers): compose overrides DB_HOST/DB_PORT with
# the postgres service address — the values below only need to match the
# postgres service credentials (user/password/db name).
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=megha
DB_PASSWORD=megha@123
DB_NAME=nestdb

# First admin created by `npm run seed -w backend` (override if needed):
# SEED_ADMIN_EMAIL=admin@syncboard.dev
# SEED_ADMIN_PASSWORD=password123
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_ROLE=ADMIN
